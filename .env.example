DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/lifedashboard
SERVER_ENV=development

# Hevy
HEVY_API_KEY=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/api/v1/auth/strava/callback

# ZenMoney (get token at https://zerro.app/token)
ZENMONEY_TOKEN=

# Todoist
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TODOIST_REDIRECT_URI=http://localhost:8080/api/v1/auth/todoist/callback

# AI (claude-code-api gateway - https://github.com/codingworkflow/claude-code-api)
# Run locally: cd /tmp/claude-code-api && .venv/bin/uvicorn claude_code_api.main:app --port 8000
AI_BASE_URL=http://host.docker.internal:8000
AI_MODEL=claude-sonnet-4-5-20250929

# Web Push (generate once with webpush.GenerateVAPIDKeys)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBSCRIBER=mailto:admin@example.com
